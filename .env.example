# Copy to `.env`. Mirrors apps/api/src/moneymatch_api/config.py; the API fails fast on a missing required var.
# Quote any value containing spaces or angle brackets: `make` targets shell-source this file.

# Runtime: local | dev | prod.
ENV=local

# Database (asyncpg URL; postgres:// and postgresql:// are rewritten). DB_PORT is the compose host port.
DATABASE_URL=postgresql+asyncpg://moneymatch:moneymatch@localhost:5432/moneymatch
DB_PORT=5432

# Auth (Supabase): set SUPABASE_JWT_SECRET for HS256, or leave it empty to use the project's JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# CORS: comma-separated browser origins (in prod, the exact web origin).
WEB_ORIGIN=http://localhost:5173

# Web Push (VAPID): push is off without a keypair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Observability: empty values disable Sentry / PostHog. Sentry prefers RENDER_GIT_COMMIT over RELEASE.
SENTRY_DSN=
RELEASE=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SLOW_HOST_MS=2000

# Email (Resend): no key, no email. The From domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Money Match <noreply@send.dueloro.com>"

# Real-money rails: guarded in code; leave false.
PAYMENTS_LIVE=false
KYC_LIVE=false

# Hardening.
GEO_ENFORCE_SEEDED_FLOOR=true
MAX_REQUEST_BYTES=65536
RATE_LIMIT_WRITES_PER_MINUTE=60

# Dev/e2e sign-in bypass (never in prod).
E2E_AUTH_ENABLED=false

# Web app (Vite).
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
VITE_E2E_AUTH=false
