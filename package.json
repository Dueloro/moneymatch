{
  "name": "moneymatch",
  "version": "0.0.0",
  "private": true,
  "description": "MoneyMatch MVP — peer-to-peer skill wagering on games you already play.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "pnpm --filter @moneymatch/web dev",
    "build": "pnpm --filter @moneymatch/web build",
    "lint": "pnpm --filter @moneymatch/web lint",
    "typecheck": "pnpm --filter @moneymatch/web typecheck",
    "test": "pnpm --filter @moneymatch/web test",
    "gen:api": "curl -sf ${API_BASE_URL:-http://localhost:8000}/openapi.json -o packages/api-client/openapi.json && pnpm --filter @moneymatch/api-client gen"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-wrjc-x8rr-h8h6",
        "GHSA-jjmj-jmhj-qwj2",
        "GHSA-337j-9hxr-rhxg",
        "GHSA-mh99-v99m-4gvg"
      ]
    },
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "brace-expansion@1.x": "^1.1.12",
      "brace-expansion@2.x": "^2.0.2",
      "brace-expansion@5.x": "^5.0.8"
    }
  }
}
