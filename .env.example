# Copy to `.env`. Quote values containing spaces or <>: `make` shell-sources this file.

# Runtime (local | dev | prod)
ENV=local

# Database
DATABASE_URL=postgresql+asyncpg://moneymatch:moneymatch@localhost:5432/moneymatch
DB_PORT=5432

# Auth (Supabase): blank SUPABASE_JWT_SECRET verifies via the project's JWKS
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# CORS
WEB_ORIGIN=http://localhost:5173

# Web Push: off without a VAPID keypair
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Observability: blank values disable Sentry / PostHog
SENTRY_DSN=
RELEASE=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SLOW_HOST_MS=2000

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Money Match <noreply@send.dueloro.com>"
SUPPORT_EMAIL=support@dueloro.com
SUPPORT_INBOUND_DOMAIN=reply.dueloro.com

# Real-money rails (keep false)
PAYMENTS_LIVE=false
KYC_LIVE=false

# Hardening
GEO_ENFORCE_SEEDED_FLOOR=true
MAX_REQUEST_BYTES=65536
RATE_LIMIT_WRITES_PER_MINUTE=60

# e2e sign-in bypass (dev only; never in prod)
E2E_AUTH_ENABLED=false

# web app
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
VITE_E2E_AUTH=false
