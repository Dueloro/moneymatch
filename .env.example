# MoneyMatch environment. Copy to `.env` and fill in.
# `apps/api/src/moneymatch_api/config.py` fails fast if a required var is missing.

# --- Runtime -----------------------------------------------------------------
# One of: local | dev | prod. Controls log formatting and debug behaviour.
ENV=local

# --- Database ----------------------------------------------------------------
# Async SQLAlchemy URL. Local Docker default shown; Supabase/Neon in dev/prod.
# NOTE: use the asyncpg driver (postgresql+asyncpg://...).
DATABASE_URL=postgresql+asyncpg://moneymatch:moneymatch@localhost:5432/moneymatch
# Host port the compose Postgres binds to. Override if 5432 is taken, and keep
# DATABASE_URL's port in sync.
DB_PORT=5432

# --- Auth (Supabase) ---------------------------------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# HS256 verification: the project's JWT secret (Supabase → Settings → API → JWT Secret).
# Leave blank to use asymmetric JWKS verification instead (SUPABASE_JWKS_URL).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Optional: JWKS endpoint for RS256/ES256 projects. Defaults to
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json when SUPABASE_JWT_SECRET is unset.
SUPABASE_JWKS_URL=
# Expected `aud` claim (Supabase issues "authenticated").
SUPABASE_JWT_AUDIENCE=authenticated

# --- Web origin / CORS -------------------------------------------------------
# Comma-separated list of allowed browser origins for the API.
WEB_ORIGIN=http://localhost:5173

# --- Host game APIs (used from Phase 2) --------------------------------------
# PUBG developer API key (https://developer.pubg.com). Direct to the official API.
PUBG_API_KEY=

# --- Web Push (VAPID) --------------------------------------------------------
# Generate a keypair (py-vapid / web-push). Public key is exposed to browsers;
# the private key is a secret. Without them, push is disabled (no-op).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
# Release tag on Sentry events + PostHog captures (set to the git SHA in deploy).
RELEASE=
# Server-side product analytics (PostHog). Empty ⇒ server capture is a no-op.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Warn when a host-API call exceeds this many milliseconds (ops signal).
SLOW_HOST_MS=2000

# --- Transactional email (Resend) --------------------------------------------
# API key from the Resend dashboard. Empty ⇒ email is a no-op (in-app + push
# still deliver). Only real addresses (e.g. Google sign-in) are emailed;
# synthetic username addresses (@users.moneymatch.app) are always skipped.
RESEND_API_KEY=
# From header for outbound mail. The domain must be verified in Resend
# (SPF/DKIM) or delivery is rejected.
EMAIL_FROM="Money Match <noreply@moneymatch.app>"

# --- Payments / KYC readiness (Phase 7) --------------------------------------
# The ONLY switches for real rails, and both are guarded in code: turning either
# on with no live provider compiled in raises at startup/first use. Leave false
# at MVP — real integration is a code change plus a flip, never a flip alone.
PAYMENTS_LIVE=false
KYC_LIVE=false

# --- Hardening (Phase 7) -----------------------------------------------------
# Max request body size in bytes (413 above this).
MAX_REQUEST_BYTES=65536
# Per-minute write/auth-sensitive request cap per client (429 above this).
RATE_LIMIT_WRITES_PER_MINUTE=60
# Dev/e2e sign-in bypass: true mounts POST /api/v1/dev/e2e/token, which mints an
# HS256 JWT for a seeded auth_id so Playwright can authenticate without live
# Supabase. NEVER set true in prod (also code-guarded on env != prod). Default off.
E2E_AUTH_ENABLED=false
# Demo-login bypass: true mounts POST /api/v1/demo/login, a complete Supabase-free
# sign-in for a single shared demo user (auto-provisioned + onboarded). Its token
# is accepted alongside real Supabase auth, so Google / email+password keep
# working. The web app needs no build flag — the button drives it. Play-money
# only; NEVER enable on a real-money deployment.
DEMO_LOGIN_ENABLED=false

# --- Web app (Vite; must be prefixed VITE_ to reach the browser) -------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable/anon key (safe for the browser).
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# PostHog browser key + host (empty ⇒ client telemetry stays console-only).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Sentry browser DSN (empty ⇒ error tracking disabled in browser).
VITE_SENTRY_DSN=
# Dev/e2e only: true makes the app authenticate from the mm.e2e.access_token
# localStorage key (paired with API E2E_AUTH_ENABLED). Never true in a prod build.
VITE_E2E_AUTH=false

# Demo escape hatch: admin-only endpoints to inject a finished match and to
# force a contest to settle. Injected results are indistinguishable downstream
# from real ones, so never set this on a real-money deployment.
DEMO_SIMULATE_ENABLED=false

# Steam Web API key (steamcommunity.com/dev/apikey). Ban checks at link time and
# the lifetime-K/D prior. Without it both degrade rather than failing the link.
STEAM_API_KEY=

# Steam OpenID sign-in. The realm must match the return URL's origin or Steam
# refuses the login.
# Optional. Both default to WEB_ORIGIN (+ /auth/steam/callback), so a deployment
# states its address once. Set them only when the callback is served from a
# different host than the app.
STEAM_OPENID_REALM=
STEAM_OPENID_RETURN_URL=

# Game Coordinator sidecar. Reads match data for arbitrary users, so it binds to
# loopback and is shared-secret protected. Never expose it to the internet.
GC_SIDECAR_URL=http://127.0.0.1:8787
GC_SHARED_SECRET=

# GC sidecar login. Get one with `npx steam-session` in gc-sidecar/, not a
# password plus a Guard code (those expire in ~30 seconds and will not survive
# a restart). The account must have played CS2; a new account is limited and
# may never attach to the Game Coordinator.
GC_REFRESH_TOKEN=

# Only when the sidecar shares a Steam account with a person. It idles out of
# Steam after this many seconds, so the account is free to play in between and
# is only taken over for the second or two it takes to resolve a share code.
# Leave unset in production, where the account is dedicated to the sidecar.
GC_IDLE_LOGOUT_SECONDS=

# Automatic CS2 share-code collection (Valve's GetNextMatchSharingCode chain).
# On by default, and the only CS2 ingest path — switch it off only to pause
# collection during a sidecar outage.
VALVE_CHAIN_ENABLED=true

# SteamID64 of the account the sidecar signs in as. Lets the supervisor ask
# Steam whether that account is in CS2 before connecting -- connecting means
# announcing you are playing, which evicts whoever is actually playing.
GC_STEAM_ID=
